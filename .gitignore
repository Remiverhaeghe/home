# Flutter et Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
.idea/
.vscode/

# Textes générés par flutter gen-l10n
lib/l10n/gen/

# Android : build.gradle.kts et le manifeste sont versionnés, le reste est recréé par
# « flutter create --platforms=android --org fr.remiverhaeghe --project-name home . »
/android/*
!/android/app/
/android/app/*
!/android/app/build.gradle.kts
!/android/app/src/
/android/app/src/*
!/android/app/src/main/
/android/app/src/main/*
!/android/app/src/main/AndroidManifest.xml
# Widget d'écran d'accueil : sa classe, sa disposition et sa description
!/android/app/src/main/kotlin/
/android/app/src/main/kotlin/*
!/android/app/src/main/kotlin/fr/
/android/app/src/main/kotlin/fr/*
!/android/app/src/main/kotlin/fr/remiverhaeghe/
/android/app/src/main/kotlin/fr/remiverhaeghe/*
!/android/app/src/main/kotlin/fr/remiverhaeghe/home/
/android/app/src/main/kotlin/fr/remiverhaeghe/home/*
!/android/app/src/main/kotlin/fr/remiverhaeghe/home/HomeWidget.kt
!/android/app/src/main/res/
/android/app/src/main/res/*
!/android/app/src/main/res/layout/
!/android/app/src/main/res/xml/
/ios/
/web/
/linux/
/macos/
/windows/

# Clé de signature, jamais dans le dépôt
*.jks
*.keystore
key.properties

# Captures générées par le workflow Captures
test/captures/png/
